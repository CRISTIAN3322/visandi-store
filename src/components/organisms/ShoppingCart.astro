---
import Button from '../atoms/Button.astro';

interface Props {
  phoneNumber?: string;
}

const { phoneNumber = '573123293314' } = Astro.props;
---

<!-- Overlay para el carrito -->
<div class="cart-overlay" id="cartOverlay"></div>

<div class="shopping-cart">
  <div class="shopping-cart__header">
    <div class="shopping-cart__decoration">
      <div class="shopping-cart__decoration-circle shopping-cart__decoration-circle--1"></div>
      <div class="shopping-cart__decoration-circle shopping-cart__decoration-circle--2"></div>
    </div>
    
    <div class="shopping-cart__header-content">
      <div class="shopping-cart__icon-container">
        <svg xmlns="http://www.w3.org/2000/svg" class="shopping-cart__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h2 class="shopping-cart__title">Carrito de Compras</h2>
    </div>
    
    <button class="shopping-cart__close">
      <svg xmlns="http://www.w3.org/2000/svg" class="shopping-cart__close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  
  <div class="shopping-cart__body">
    <div class="shopping-cart__empty">
      <div class="shopping-cart__empty-icon-container">
        <svg xmlns="http://www.w3.org/2000/svg" class="shopping-cart__empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h3 class="shopping-cart__empty-title">Tu carrito está vacío</h3>
      <p class="shopping-cart__empty-description">Explora nuestros productos y agrega los que más te gusten para realizar tu pedido</p>
      <a href="#productos" class="shopping-cart__empty-btn btn btn--primary">
        Ver Productos
      </a>
    </div>
    
    <div class="shopping-cart__items hidden">
      <!-- Los items del carrito se generarán dinámicamente con JavaScript -->
    </div>
  </div>
  
  <div class="shopping-cart__footer hidden" id="cartFooter">
    <div class="shopping-cart__total-card">
      <div class="shopping-cart__total-row">
        <span class="shopping-cart__total-label">Total a Pagar:</span>
        <span class="shopping-cart__total-amount cart-total">$0.00</span>
      </div>
      <div class="shopping-cart__total-note">
        Incluye envío y manejo
      </div>
    </div>
    
    <div class="shopping-cart__buttons">
      <Button 
        text="Enviar Pedido por WhatsApp" 
        type="primary" 
        fullWidth={true}
        icon="📱"
        onClick="sendOrderByWhatsApp()"
      />
      <Button 
        text="Vaciar Carrito" 
        type="secondary" 
        fullWidth={true}
        onClick="clearCart()"
      />
    </div>
  </div>
</div>

<script define:vars={{ phoneNumber }}>
  // Importar funciones del servicio (simulado para Astro)
  // En producción, esto se haría con un bundler o módulos ES
  
  // Definir addToCart globalmente usando el servicio
  window.addToCart = function(id, name, price, image) {
    try {
      const priceNum = typeof price === 'string' ? parseFloat(price) : Number(price);
      if (isNaN(priceNum)) {
        console.error('Precio inválido:', price);
        return;
      }
      
      const cartStr = localStorage.getItem('shopping-cart');
      let cart = cartStr ? JSON.parse(cartStr) : [];
      if (!Array.isArray(cart)) cart = [];
      
      const existingItem = cart.find(item => String(item.id) === String(id));
      
      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({
          id: String(id),
          name: String(name),
          price: priceNum,
          images: [String(image)],
          quantity: 1
        });
      }
      
      localStorage.setItem('shopping-cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cartUpdated'));
      
      if (typeof showNotification === 'function') {
        showNotification(`${name} agregado al carrito`, 'success');
      }
    } catch (error) {
      console.error('Error al agregar producto:', error);
    }
  };
  
  // Cargar y mostrar carrito
  function loadCart() {
    try {
      const cartStr = localStorage.getItem('shopping-cart');
      const cart = cartStr ? JSON.parse(cartStr) : [];
      
      if (!Array.isArray(cart) || cart.length === 0) {
        document.querySelector('.shopping-cart__empty')?.classList.remove('hidden');
        document.querySelector('.shopping-cart__items')?.classList.add('hidden');
        document.getElementById('cartFooter')?.classList.add('hidden');
        return;
      }
      
      document.querySelector('.shopping-cart__empty')?.classList.add('hidden');
      document.querySelector('.shopping-cart__items')?.classList.remove('hidden');
      document.getElementById('cartFooter')?.classList.remove('hidden');
      
      const itemsContainer = document.querySelector('.shopping-cart__items');
      if (itemsContainer) {
        itemsContainer.innerHTML = cart.map(item => {
          const imageUrl = (item.images && item.images[0]) ? item.images[0] : '/images/products/logo.png';
          return `
          <div class="shopping-cart__item">
            <div class="shopping-cart__item-content">
              <div class="shopping-cart__item-image-container">
                <img src="${imageUrl}" alt="${String(item.name || 'Producto').replace(/"/g, '&quot;')}" class="shopping-cart__item-image" onerror="this.src='/images/products/logo.png'">
                <span class="shopping-cart__item-quantity-badge">${item.quantity}</span>
              </div>
              <div class="shopping-cart__item-details">
                <h4 class="shopping-cart__item-name">${String(item.name || 'Producto').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</h4>
                <p class="shopping-cart__item-price">$${window.formatPrice ? window.formatPrice(Number(item.price || 0)) : Number(item.price || 0).toLocaleString()}</p>
              </div>
            </div>
          </div>
        `;
        }).join('');
      }
      
      // Actualizar total
      const subtotal = cart.reduce((sum, item) => sum + (Number(item.price) * Number(item.quantity)), 0);
      const shipping = subtotal > 50000 ? 0 : 5000;
      const total = subtotal + shipping;
      const totalEl = document.querySelector('.cart-total');
      if (totalEl) totalEl.textContent = `$${window.formatPrice ? window.formatPrice(total) : total.toLocaleString()}`;
    } catch (error) {
      console.error('Error al cargar carrito:', error);
    }
  }
  
  // Funciones globales
  window.clearCart = function() {
    localStorage.removeItem('shopping-cart');
    window.dispatchEvent(new CustomEvent('cartUpdated'));
    loadCart();
    if (typeof showNotification === 'function') {
      showNotification('Carrito vaciado', 'info');
    }
  };
  
  window.sendOrderByWhatsApp = function() {
    try {
      // Obtener carrito
      const cartStr = localStorage.getItem('shopping-cart');
      if (!cartStr) {
        alert('Tu carrito está vacío');
        return;
      }
      
      let cart;
      try {
        cart = JSON.parse(cartStr);
      } catch (e) {
        console.error('Error al parsear carrito:', e);
        alert('Error al leer el carrito');
        return;
      }
      
      if (!Array.isArray(cart) || cart.length === 0) {
        alert('Tu carrito está vacío');
        return;
      }
      
      // Obtener número de WhatsApp del distribuidor
      let distributorNumber = phoneNumber || '573123293314'; // Usar prop o valor por defecto
      
      // Intentar obtener del localStorage
      const saved = localStorage.getItem('whatsapp-number');
      if (saved && saved.replace(/[^0-9]/g, '').length >= 10) {
        distributorNumber = saved.replace(/[^0-9]/g, '');
      }
      
      // Crear mensaje personalizado
      let message = `*🛒 NUEVO PEDIDO - VISANDI STORE*\n\n`;
      message += `*📦 PRODUCTOS A COMPRAR:*\n\n`;
      
      cart.forEach((item, index) => {
        const itemPrice = Number(item.price) || 0;
        const itemQuantity = Number(item.quantity) || 0;
        const itemSubtotal = itemPrice * itemQuantity;
        
        message += `${index + 1}. *${String(item.name || 'Producto').replace(/\*/g, '')}*\n`;
        message += `   • Cantidad: ${itemQuantity}\n`;
        const formatPrice = window.formatPrice || ((p) => p.toLocaleString());
        message += `   • Precio unitario: $${formatPrice(itemPrice)}\n`;
        message += `   • Subtotal: $${formatPrice(itemSubtotal)}\n\n`;
      });
      
      // Calcular totales
      const subtotal = cart.reduce((sum, item) => {
        const price = Number(item.price) || 0;
        const quantity = Number(item.quantity) || 0;
        return sum + (price * quantity);
      }, 0);
      
      const shipping = subtotal > 50000 ? 0 : 5000;
      const total = subtotal + shipping;
      
      message += `*💰 RESUMEN DEL PEDIDO:*\n`;
      const formatPrice = window.formatPrice || ((p) => p.toLocaleString());
      message += `• Subtotal: $${formatPrice(subtotal)}\n`;
      message += `• Envío: ${shipping === 0 ? 'GRATIS' : `$${formatPrice(shipping)}`}\n`;
      message += `• *TOTAL A PAGAR: $${formatPrice(total)}*\n\n`;
      message += `¡Gracias por tu pedido! 🎉\n`;
      message += `Te contactaremos pronto para confirmar los detalles.`;
      
      // Codificar mensaje y crear URL
      const encodedMessage = encodeURIComponent(message);
      const whatsappUrl = `https://wa.me/${distributorNumber}?text=${encodedMessage}`;
      
      // Abrir WhatsApp en nueva ventana
      const whatsappWindow = window.open(whatsappUrl, '_blank');
      
      if (whatsappWindow) {
        // Vaciar el carrito después de enviar el pedido
        localStorage.removeItem('shopping-cart');
        window.dispatchEvent(new CustomEvent('cartUpdated'));
        loadCart();
        if (typeof showNotification === 'function') {
          showNotification('Pedido enviado. El carrito ha sido vaciado.', 'success');
        } else {
          alert('Pedido enviado. El carrito ha sido vaciado.');
        }
      } else {
        // Si el popup fue bloqueado, mostrar el enlace
        alert('Por favor, permite ventanas emergentes o copia este enlace:\n' + whatsappUrl);
        console.error('Popup bloqueado. URL:', whatsappUrl);
      }
    } catch (error) {
      console.error('Error completo al enviar pedido:', error);
      alert('Error al enviar el pedido: ' + (error instanceof Error ? error.message : 'Error desconocido'));
    }
  };
  
  // Funciones para abrir/cerrar el carrito
  function openCart() {
    const cart = document.querySelector('.shopping-cart');
    const overlay = document.getElementById('cartOverlay');
    if (cart) {
      cart.classList.add('shopping-cart--open');
      document.body.style.overflow = 'hidden';
    }
    if (overlay) {
      overlay.classList.add('cart-overlay--active');
    }
  }

  function closeCart() {
    const cart = document.querySelector('.shopping-cart');
    const overlay = document.getElementById('cartOverlay');
    if (cart) {
      cart.classList.remove('shopping-cart--open');
      document.body.style.overflow = '';
    }
    if (overlay) {
      overlay.classList.remove('cart-overlay--active');
    }
  }

  // Hacer funciones globales
  window.openCart = openCart;
  window.closeCart = closeCart;

  // Inicializar
  document.addEventListener('DOMContentLoaded', () => {
    loadCart();
    window.addEventListener('cartUpdated', loadCart);
    
    // Botón cerrar carrito
    const closeBtn = document.querySelector('.shopping-cart__close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeCart);
    }
    
    // Abrir carrito automáticamente cuando se agrega un producto
    window.addEventListener('cartUpdated', () => {
      const cartStr = localStorage.getItem('shopping-cart');
      const cart = cartStr ? JSON.parse(cartStr) : [];
      if (Array.isArray(cart) && cart.length > 0) {
        openCart();
      }
    });
    
    // Cerrar carrito al hacer clic en el overlay
    const overlay = document.getElementById('cartOverlay');
    if (overlay) {
      overlay.addEventListener('click', closeCart);
    }
    
    // Conectar enlace del header del carrito
    const headerCartLink = document.getElementById('headerCartLink');
    if (headerCartLink) {
      headerCartLink.addEventListener('click', (e) => {
        e.preventDefault();
        openCart();
      });
    }
    
    // Cerrar carrito con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const cart = document.querySelector('.shopping-cart');
        if (cart && cart.classList.contains('shopping-cart--open')) {
          closeCart();
        }
      }
    });
  });
</script>

<style>
  /* Estilos del carrito lateral - mantener los existentes */
  .shopping-cart {
    position: fixed;
    right: 0;
    top: 0;
    height: 100vh;
    width: 100%;
    max-width: 28rem;
    background: var(--color-background-surface);
    box-shadow: var(--shadow-2xl);
    transform: translateX(100%);
    transition: all var(--transition-slow);
    z-index: var(--z-index-modal);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(20px);
    border-left: var(--border-width-1) solid var(--blue-200);
    overflow-y: auto;
  }

  .shopping-cart--open {
    transform: translateX(0);
  }

  .shopping-cart__header {
    padding: var(--space-6);
    border-bottom: var(--border-width-1) solid var(--blue-200);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--gradient-hero);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .shopping-cart__decoration {
    position: absolute;
    inset: 0;
    opacity: 0.2;
  }

  .shopping-cart__decoration-circle {
    position: absolute;
    background: white;
    border-radius: var(--border-radius-full);
    mix-blend-mode: multiply;
    filter: blur(40px);
    animation: pulse 4s ease-in-out infinite;
  }

  .shopping-cart__decoration-circle--1 {
    top: var(--space-2);
    left: var(--space-2);
    width: 4rem;
    height: 4rem;
  }

  .shopping-cart__decoration-circle--2 {
    bottom: var(--space-2);
    right: var(--space-2);
    width: 5rem;
    height: 5rem;
    animation-delay: 2s;
  }

  .shopping-cart__header-content {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
  }

  .shopping-cart__icon-container {
    padding: var(--space-2);
    background: rgba(255, 255, 255, 0.2);
    border-radius: var(--border-radius-full);
    margin-right: var(--space-3);
    backdrop-filter: blur(10px);
  }

  .shopping-cart__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .shopping-cart__title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    margin: 0;
  }

  .shopping-cart__close {
    position: relative;
    z-index: 10;
    color: white;
    background: none;
    border: none;
    padding: var(--space-2);
    border-radius: var(--border-radius-full);
    transition: all var(--transition-normal);
    cursor: pointer;
  }

  .shopping-cart__close:hover {
    color: var(--slate-300);
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
    backdrop-filter: blur(10px);
  }

  .shopping-cart__close-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .shopping-cart__body {
    flex: 1;
    overflow-y: auto;
    background: linear-gradient(180deg, var(--color-background-primary) 0%, var(--color-background-surface) 100%);
  }

  .shopping-cart__empty {
    text-align: center;
    padding: var(--space-16) var(--space-6);
  }

  .shopping-cart__empty-icon-container {
    width: 6rem;
    height: 6rem;
    margin: 0 auto var(--space-6);
    background: linear-gradient(135deg, var(--blue-100) 0%, var(--blue-200) 100%);
    border-radius: var(--border-radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shopping-cart__empty-icon {
    width: 3rem;
    height: 3rem;
    color: var(--color-primary);
  }

  .shopping-cart__empty-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .shopping-cart__empty-description {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--space-6) 0;
  }

  .shopping-cart__empty-btn {
    display: inline-block;
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-6);
    background: var(--gradient-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-full);
    font-weight: var(--font-weight-medium);
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-lg);
  }

  .shopping-cart__empty-btn:hover {
    background: linear-gradient(135deg, var(--blue-700) 0%, var(--blue-600) 100%);
    transform: scale(1.05);
    box-shadow: var(--shadow-xl);
  }

  .shopping-cart__items {
    padding: var(--space-6);
  }

  .shopping-cart__item {
    background: var(--color-background-surface);
    border-radius: var(--border-radius-xl);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
    border: var(--border-width-1) solid var(--blue-200);
    margin-bottom: var(--space-4);
  }

  .shopping-cart__item-content {
    display: flex;
    align-items: center;
  }

  .shopping-cart__item-image-container {
    position: relative;
  }

  .shopping-cart__item-image {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: var(--border-radius-xl);
    box-shadow: var(--shadow-md);
  }

  .shopping-cart__item-quantity-badge {
    position: absolute;
    top: -var(--space-1);
    right: -var(--space-1);
    background: var(--gradient-primary);
    color: white;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    border-radius: var(--border-radius-full);
    height: 1.25rem;
    width: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shopping-cart__item-details {
    margin-left: var(--space-4);
    flex: 1;
  }

  .shopping-cart__item-name {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
  }

  .shopping-cart__item-price {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .shopping-cart__footer {
    padding: var(--space-6);
    border-top: var(--border-width-1) solid var(--blue-200);
    background: linear-gradient(135deg, var(--color-background-primary) 0%, var(--color-background-surface) 100%);
  }

  .shopping-cart__total-card {
    background: var(--color-background-surface);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    border: var(--border-width-1) solid var(--blue-200);
    margin-bottom: var(--space-6);
  }

  .shopping-cart__total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .shopping-cart__total-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .shopping-cart__total-amount {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .shopping-cart__total-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .shopping-cart__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hidden {
    display: none !important;
  }

  /* Overlay del carrito */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1009;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .cart-overlay--active {
    opacity: 1;
    pointer-events: all;
    cursor: pointer;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .shopping-cart {
      max-width: 100%;
    }
    
    .shopping-cart__header {
      padding: var(--space-4);
    }
    
    .shopping-cart__title {
      font-size: var(--font-size-lg);
    }
    
    .shopping-cart__items {
      padding: var(--space-4);
    }
    
    .shopping-cart__item {
      padding: var(--space-3);
    }
    
    .shopping-cart__item-image {
      width: 4rem;
      height: 4rem;
    }
    
    .shopping-cart__item-name {
      font-size: var(--font-size-sm);
    }
    
    .shopping-cart__item-price {
      font-size: var(--font-size-xs);
    }
    
    .shopping-cart__footer {
      padding: var(--space-4);
    }
    
    .shopping-cart__total-card {
      padding: var(--space-4);
    }
    
    .shopping-cart__total-label {
      font-size: var(--font-size-base);
    }
    
    .shopping-cart__total-amount {
      font-size: var(--font-size-xl);
    }
  }
  
  @media (max-width: 480px) {
    .shopping-cart__header {
      padding: var(--space-3);
    }
    
    .shopping-cart__title {
      font-size: var(--font-size-base);
    }
    
    .shopping-cart__icon {
      width: 1.25rem;
      height: 1.25rem;
    }
    
    .shopping-cart__items {
      padding: var(--space-3);
    }
    
    .shopping-cart__item {
      padding: var(--space-2);
      margin-bottom: var(--space-3);
    }
    
    .shopping-cart__item-image {
      width: 3.5rem;
      height: 3.5rem;
    }
    
