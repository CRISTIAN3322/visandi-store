---
// Props opcionales; por defecto replican el contenido original sin cambiar funcionalidad
interface Props {
  title?: string;
  highlight?: string;
  description?: string;
}

const {
  title = 'Bienvenido a',
  highlight = 'Visandi Store',
  description = 'Explora nuestra selección de productos únicos y realiza tu pedido fácilmente por WhatsApp.',
} = Astro.props;

const heartPath =
  'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
---

<section class="hero">
  <!-- Elementos decorativos existentes -->
  <div class="hero__decoration">
    <div class="hero__decoration-circle hero__decoration-circle--1"></div>
    <div class="hero__decoration-circle hero__decoration-circle--2"></div>
    <div class="hero__decoration-circle hero__decoration-circle--3"></div>
  </div>

  <!-- Corazones flotantes (decorativo, no interactivo) -->
  <div class="hero__hearts" aria-hidden="true">
    <svg class="hero__heart hero__heart--1" viewBox="0 0 24 24" fill="currentColor"><path d={heartPath} /></svg>
    <svg class="hero__heart hero__heart--2" viewBox="0 0 24 24" fill="currentColor"><path d={heartPath} /></svg>
    <svg class="hero__heart hero__heart--3 hero__heart--outline" viewBox="0 0 24 24"><path d={heartPath} /></svg>
    <svg class="hero__heart hero__heart--4" viewBox="0 0 24 24" fill="currentColor"><path d={heartPath} /></svg>
    <svg class="hero__heart hero__heart--5 hero__heart--outline" viewBox="0 0 24 24"><path d={heartPath} /></svg>
  </div>

  <div class="hero__container container">
    <div class="hero__content">
      <h1 class="hero__title">
        {title} <span class="hero__title-highlight">{highlight}</span>
        <svg class="hero__title-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={heartPath} />
        </svg>
      </h1>
      <p class="hero__description">{description}</p>
      <div class="hero__buttons">
        <a href="#productos" class="hero__btn hero__btn--primary btn btn--lg">
          Ver Productos
        </a>
        <a href="#contacto" class="hero__btn hero__btn--secondary btn btn--lg">
          Contactar
        </a>
      </div>
    </div>
  </div>
</section>