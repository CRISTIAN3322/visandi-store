---
import ProductImage from '../atoms/ProductImage.astro';
import { DEFAULT_WHATSAPP_NUMBER } from '../../config/whatsapp';

interface Props {
  id: string;
  name: string;
  images: string[];
  description: string;
}

const {
  id,
  name,
  images,
  description
} = Astro.props;
---

<div class="product-card" data-product-id={id}>
  <!-- Imagen del producto -->
  <div class="product-card__images">
    {images.map((image, index) => (
      <div class={`product-card__image ${index === 0 ? 'product-card__image--active' : ''}`} data-index={index}>
        <ProductImage src={image} alt={`${name} - Imagen ${index + 1}`} class="product-card__image-content" />
      </div>
    ))}

    <!-- Overlay con gradiente -->
    <div class="product-card__gradient"></div>

    <!-- Controles de navegación de imágenes -->
    {images.length > 1 && (
      <>
        <div class="product-card__controls">
          {images.map((_, index) => (
            <button
              class={`product-card__dot ${index === 0 ? 'product-card__dot--active' : ''}`}
              data-control={index}
              aria-label={`Ver imagen ${index + 1}`}
            ></button>
          ))}
        </div>

        <button class="product-card__nav product-card__nav--prev" aria-label="Imagen anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button class="product-card__nav product-card__nav--next" aria-label="Imagen siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}

    <!-- Botón de favoritos -->
    <button class="product-card__favorite" aria-label="Agregar a favoritos" data-product-id={id}>
      <svg xmlns="http://www.w3.org/2000/svg" class="product-card__favorite-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>

    <!-- Botón de vista rápida -->
    <button class="product-card__quick-view" aria-label="Vista rápida" data-product-id={id}>
      <svg xmlns="http://www.w3.org/2000/svg" class="product-card__quick-view-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    </button>
  </div>

  <!-- Contenido de la tarjeta -->
  <div class="product-card__content">
    <!-- Título -->
    <div class="product-card__header">
      <h3 class="product-card__title">{name}</h3>
    </div>

    <!-- Botones de acción -->
    <div class="product-card__actions">
      <button
        class="product-card__btn product-card__btn--view"
        data-product-id={id}
      >
        Ver Detalles
      </button>
      <button
        class="product-card__btn product-card__btn--whatsapp"
        data-product-name={name}
      >
        Contactar por WhatsApp
      </button>
    </div>

    <!-- Descripción -->
    <p class="product-card__description">{description}</p>
  </div>
</div>


<script define:vars={{ id, DEFAULT_WHATSAPP_NUMBER }}>
  window.__DEFAULT_WHATSAPP_NUMBER__ = DEFAULT_WHATSAPP_NUMBER;

  window.openWhatsAppProduct = window.openWhatsAppProduct || function(productName) {
    const saved = (localStorage.getItem('whatsapp-number') || '').replace(/[^0-9]/g, '');
    const fallback = window.__DEFAULT_WHATSAPP_NUMBER__ || '573123293314';
    const number = saved && saved.length >= 10 ? saved : fallback;
    const message = encodeURIComponent(`Hola, me interesa el producto: ${productName}. ¿Podrían darme más información?`);
    window.open(`https://wa.me/${number}?text=${message}`, '_blank');
  };

  document.addEventListener('DOMContentLoaded', () => {
    const productCard = document.querySelector(`.product-card[data-product-id="${id}"]`);
    if (!productCard) return;

    const images = productCard.querySelectorAll('.product-card__image');
    const controls = productCard.querySelectorAll('[data-control]');
    const prevButton = productCard.querySelector('.product-card__nav--prev');
    const nextButton = productCard.querySelector('.product-card__nav--next');
    const favoriteButton = productCard.querySelector('.product-card__favorite');
    const quickViewButton = productCard.querySelector('.product-card__quick-view');

    // Funcionalidad de navegación de imágenes
    if (images.length > 1) {
      let currentIndex = 0;

      const updateActiveImage = (index) => {
        if (index < 0) index = images.length - 1;
        if (index >= images.length) index = 0;

        currentIndex = index;

        images.forEach((img, i) => {
          img.classList.remove('product-card__image--active');
          if (i === currentIndex) {
            setTimeout(() => img.classList.add('product-card__image--active'), 50);
          }
        });

        controls.forEach((ctrl, i) => {
          if (i === currentIndex) {
            ctrl.classList.add('product-card__dot--active');
          } else {
            ctrl.classList.remove('product-card__dot--active');
          }
        });
      };

      controls.forEach(control => {
        control.addEventListener('click', () => {
          const index = parseInt(control.getAttribute('data-control'));
          updateActiveImage(index);
        });
      });

      if (prevButton) {
        prevButton.addEventListener('click', (e) => {
          e.preventDefault();
          updateActiveImage(currentIndex - 1);
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', (e) => {
          e.preventDefault();
          updateActiveImage(currentIndex + 1);
        });
      }

      let autoplayInterval;

      const startAutoplay = () => {
        autoplayInterval = setInterval(() => {
          updateActiveImage(currentIndex + 1);
        }, 4000);
      };

      const stopAutoplay = () => {
        clearInterval(autoplayInterval);
      };

      startAutoplay();

      productCard.addEventListener('mouseenter', stopAutoplay);
      productCard.addEventListener('mouseleave', startAutoplay);

      [...controls, prevButton, nextButton].forEach(control => {
        if (control) {
          control.addEventListener('click', stopAutoplay);
          setTimeout(startAutoplay, 2000);
        }
      });
    }

    // Funcionalidad de favoritos
    if (favoriteButton) {
      const isFavorited = localStorage.getItem(`favorite-${id}`) === 'true';
      if (isFavorited) {
        favoriteButton.classList.add('product-card__favorite--active');
      }

      favoriteButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isCurrentlyFavorited = favoriteButton.classList.contains('product-card__favorite--active');

        if (isCurrentlyFavorited) {
          favoriteButton.classList.remove('product-card__favorite--active');
          localStorage.removeItem(`favorite-${id}`);
          showNotification('Producto removido de favoritos', 'info');
        } else {
          favoriteButton.classList.add('product-card__favorite--active');
          localStorage.setItem(`favorite-${id}`, 'true');
          showNotification('Producto agregado a favoritos', 'success');
        }
      });
    }

    // Funcionalidad de vista rápida
    if (quickViewButton) {
      quickViewButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        createQuickViewModal(productCard);
      });
    }

    // Botón "Ver Detalles"
    const viewDetailsBtn = productCard.querySelector('.product-card__btn--view');
    if (viewDetailsBtn) {
      viewDetailsBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        createQuickViewModal(productCard);
      });
    }

    // Botón Contactar por WhatsApp
    const whatsappBtn = productCard.querySelector('.product-card__btn--whatsapp');
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productName = whatsappBtn.getAttribute('data-product-name') || '';
        window.openWhatsAppProduct(productName);
      });
    }

    // Efecto de zoom en la imagen al hover
    const imageContainer = productCard.querySelector('.product-card__images');
    if (imageContainer) {
      imageContainer.addEventListener('mouseenter', () => {
        const activeImage = productCard.querySelector('.product-card__image--active img');
        if (activeImage) {
          activeImage.style.transform = 'scale(1.1)';
        }
      });

      imageContainer.addEventListener('mouseleave', () => {
        const activeImage = productCard.querySelector('.product-card__image--active img');
        if (activeImage) {
          activeImage.style.transform = 'scale(1)';
        }
      });
    }
  });

  // Función para crear modal de vista rápida
  function createQuickViewModal(productCard) {
    const productTitle = productCard.querySelector('.product-card__title').textContent;
    const productDescription = productCard.querySelector('.product-card__description').textContent;
    const productImages = Array.from(productCard.querySelectorAll('.product-card__image img')).map(img => img.src);

    const safeTitle = productTitle.replace(/'/g, "\\'");

    const overlay = document.createElement('div');
    overlay.className = 'quick-view-overlay';
    overlay.innerHTML = `
      <div class="quick-view-modal">
        <div class="quick-view-modal__header">
          <h3 class="quick-view-modal__title">${productTitle}</h3>
          <button class="quick-view-modal__close" aria-label="Cerrar vista rápida">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="quick-view-modal__content">
          <div class="quick-view-modal__image">
            <img src="${productImages[0]}" alt="${productTitle}" class="quick-view-modal__img">
          </div>

          <div class="quick-view-modal__details">
            <p class="quick-view-modal__description">${productDescription}</p>

            <div class="quick-view-modal__actions">
              <button class="btn btn--primary btn--full" onclick="openWhatsAppProduct('${safeTitle}'); closeQuickView();">
                Contactar por WhatsApp
              </button>
              <button class="btn btn--secondary btn--full" onclick="closeQuickView();">
                Cerrar
              </button>
            </div>
          </div>
        </div>
      </div>
    `;

    const style = document.createElement('style');
    style.textContent = `
      .quick-view-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: fadeIn 0.3s ease-out;
      }

      .quick-view-modal {
        background: var(--color-background-surface);
        border-radius: 1rem;
        max-width: 800px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        animation: slideInUp 0.3s ease-out;
      }

      .quick-view-modal__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--color-text-secondary) 15%, transparent);
      }

      .quick-view-modal__title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-text-primary);
        margin: 0;
      }

      .quick-view-modal__close {
        background: none;
        border: none;
        padding: 0.5rem;
        border-radius: 0.5rem;
        cursor: pointer;
        color: var(--color-text-secondary);
        transition: all 0.2s ease;
      }

      .quick-view-modal__close:hover {
        background: var(--color-background-secondary);
        color: var(--color-text-primary);
      }

      .quick-view-modal__close svg {
        width: 1.5rem;
        height: 1.5rem;
      }

      .quick-view-modal__content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        padding: 1.5rem;
      }

      .quick-view-modal__image {
        aspect-ratio: 1;
        border-radius: 0.75rem;
        overflow: hidden;
      }

      .quick-view-modal__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .quick-view-modal__description {
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-bottom: 2rem;
      }

      .quick-view-modal__actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      @media (max-width: 768px) {
        .quick-view-modal__content {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        .quick-view-modal__title {
          font-size: 1.25rem;
        }
        .quick-view-modal__actions {
          flex-direction: column-reverse;
        }
      }

      @media (max-width: 480px) {
        .quick-view-modal__header {
          padding: 1rem;
        }
        .quick-view-modal__content {
          padding: 1rem;
        }
        .quick-view-modal__description {
          margin-bottom: 1.25rem;
        }
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes slideInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    `;

    document.head.appendChild(style);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';

    const closeQuickView = () => {
      overlay.style.animation = 'fadeOut 0.3s ease-out forwards';
      setTimeout(() => {
        if (overlay.parentElement) {
          document.body.removeChild(overlay);
        }
        if (style.parentElement) {
          document.head.removeChild(style);
        }
        document.body.style.overflow = '';
        document.removeEventListener('keydown', handleEscape);
      }, 300);
    };

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeQuickView();
      }
    });

    setTimeout(() => {
      const closeButton = overlay.querySelector('.quick-view-modal__close');
      if (closeButton) {
        closeButton.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          closeQuickView();
        });
      }
    }, 0);

    const handleEscape = (e) => {
      if (e.key === 'Escape') {
        closeQuickView();
      }
    };
    document.addEventListener('keydown', handleEscape);

    window.closeQuickView = closeQuickView;
  }

  // Función para mostrar notificaciones
  function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.className = `notification notification--${type}`;
    notification.innerHTML = `
      <div class="notification__content">
        <span class="notification__icon">${type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️'}</span>
        <span class="notification__message">${message}</span>
        <button class="notification__close" onclick="this.parentElement.parentElement.remove()">×</button>
      </div>
    `;

    document.body.appendChild(notification);

    setTimeout(() => {
      if (notification.parentElement) {
        notification.remove();
      }
    }, 3000);
  }
</script>
