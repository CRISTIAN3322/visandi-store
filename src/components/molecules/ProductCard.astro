---
import ProductImage from '../atoms/ProductImage.astro';
import Button from '../atoms/Button.astro';

interface Props {
  id: string;
  name: string;
  price: number;
  originalPrice?: number;
  images: string[];
  description: string;
  stock?: number;
  discount?: number;
  isNew?: boolean;
  isFeatured?: boolean;
  rating?: number;
  category?: string;
}

const { 
  id, 
  name, 
  price, 
  originalPrice, 
  images, 
  description, 
  stock = 10, 
  discount = 0, 
  isNew = true, 
  isFeatured = false,
  rating = 4.5,
  category = 'vela'
} = Astro.props;
---

<div class="product-card" data-product-id={id} data-category={category}>
  <!-- Imagen del producto -->
  <div class="product-card__images">
    {images.map((image, index) => (
      <div class={`product-card__image ${index === 0 ? 'product-card__image--active' : ''}`} data-index={index}>
        <ProductImage src={image} alt={`${name} - Imagen ${index + 1}`} class="product-card__image-content" />
      </div>
    ))}
    
    <!-- Overlay con gradiente -->
    <div class="product-card__gradient"></div>
    
    <!-- Controles de navegación de imágenes -->
    {images.length > 1 && (
      <>
        <div class="product-card__controls">
          {images.map((_, index) => (
            <button 
              class={`product-card__dot ${index === 0 ? 'product-card__dot--active' : ''}`}
              data-control={index}
              aria-label={`Ver imagen ${index + 1}`}
            ></button>
          ))}
        </div>
        
        <button class="product-card__nav product-card__nav--prev" aria-label="Imagen anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button class="product-card__nav product-card__nav--next" aria-label="Imagen siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}
    
    <!-- Badges superiores -->
    <div class="product-card__badges">
      {discount > 0 && (
        <div class="product-card__badge product-card__badge--discount">
          <span class="product-card__badge-text">-{discount}%</span>
        </div>
      )}
      
      {isNew && (
        <div class="product-card__badge product-card__badge--new">
          <span class="product-card__badge-text">Nuevo</span>
        </div>
      )}
      
      {isFeatured && (
        <div class="product-card__badge product-card__badge--featured">
          <span class="product-card__badge-text">⭐ Destacado</span>
        </div>
      )}
    </div>
    
    <!-- Botón de favoritos -->
    <button class="product-card__favorite" aria-label="Agregar a favoritos" data-product-id={id}>
      <svg xmlns="http://www.w3.org/2000/svg" class="product-card__favorite-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>
    
    <!-- Botón de vista rápida -->
    <button class="product-card__quick-view" aria-label="Vista rápida" data-product-id={id}>
      <svg xmlns="http://www.w3.org/2000/svg" class="product-card__quick-view-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    </button>
    
    <!-- Indicador de stock -->
    <div class="product-card__stock-indicator">
      {stock > 5 ? (
        <span class="product-card__stock product-card__stock--available">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__stock-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          En stock
        </span>
      ) : stock > 0 ? (
        <span class="product-card__stock product-card__stock--low">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__stock-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
          </svg>
          Solo {stock} disponibles
        </span>
      ) : (
        <span class="product-card__stock product-card__stock--out">
          <svg xmlns="http://www.w3.org/2000/svg" class="product-card__stock-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Agotado
        </span>
      )}
    </div>
  </div>
  
  <!-- Contenido de la tarjeta -->
  <div class="product-card__content">
    <!-- Categoría -->
    <div class="product-card__category">
      <span class="product-card__category-text">{category}</span>
    </div>
    
    <!-- Título -->
    <h3 class="product-card__title">{name}</h3>
    
    <!-- Rating -->
    <div class="product-card__rating">
      <div class="product-card__stars">
        {[1, 2, 3, 4, 5].map((star) => (
          <svg 
            class={`product-card__star ${star <= Math.floor(rating) ? 'product-card__star--filled' : ''} ${star === Math.ceil(rating) && rating % 1 !== 0 ? 'product-card__star--half' : ''}`}
            fill="currentColor" 
            viewBox="0 0 24 24"
          >
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
      </div>
      <span class="product-card__rating-text">({rating})</span>
    </div>
    
    <!-- Descripción -->
    <p class="product-card__description">{description}</p>
    
    <!-- Precios -->
    <div class="product-card__pricing">
      <div class="product-card__price-container">
        <span class="product-card__price">${price.toFixed(2)}</span>
        {originalPrice && originalPrice > price && (
          <span class="product-card__original-price">${originalPrice.toFixed(2)}</span>
        )}
      </div>
      {discount > 0 && originalPrice && (
        <span class="product-card__savings">Ahorras ${(originalPrice - price).toFixed(2)}</span>
      )}
    </div>
    
    <!-- Footer con botón -->
    <div class="product-card__footer">
      <Button 
        text={stock > 0 ? "Agregar al carrito" : "Agotado"} 
        type={stock > 0 ? "primary" : "secondary"}
        onClick={stock > 0 ? `addToCart('${id}', '${name}', ${price}, '${images[0]}')` : ''}
        fullWidth={true}
      />
    </div>
  </div>
</div>


<script define:vars={{ id }}>
  document.addEventListener('DOMContentLoaded', () => {
    const productCard = document.querySelector(`.product-card[data-product-id="${id}"]`);
    if (!productCard) return;
    
    const images = productCard.querySelectorAll('.product-card__image');
    const controls = productCard.querySelectorAll('[data-control]');
    const prevButton = productCard.querySelector('.product-card__nav--prev');
    const nextButton = productCard.querySelector('.product-card__nav--next');
    const favoriteButton = productCard.querySelector('.product-card__favorite');
    const quickViewButton = productCard.querySelector('.product-card__quick-view');
    const stockChip = productCard.querySelector('.product-card__stock');
    
    // Funcionalidad de navegación de imágenes
    if (images.length > 1) {
    let currentIndex = 0;
    
    // Función para actualizar la imagen activa
    const updateActiveImage = (index) => {
      // Asegurarse de que el índice esté dentro del rango
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      
      currentIndex = index;
      
        // Actualizar imágenes con animación
        images.forEach((img, i) => {
          img.classList.remove('product-card__image--active');
          if (i === currentIndex) {
            setTimeout(() => img.classList.add('product-card__image--active'), 50);
          }
        });
      
      // Actualizar controles
      controls.forEach((ctrl, i) => {
        if (i === currentIndex) {
            ctrl.classList.add('product-card__dot--active');
        } else {
            ctrl.classList.remove('product-card__dot--active');
        }
      });
    };
    
    // Configurar eventos para los controles de puntos
    controls.forEach(control => {
      control.addEventListener('click', () => {
        const index = parseInt(control.getAttribute('data-control'));
        updateActiveImage(index);
      });
    });
    
    // Configurar eventos para los botones de navegación
    if (prevButton) {
      prevButton.addEventListener('click', (e) => {
        e.preventDefault();
        updateActiveImage(currentIndex - 1);
      });
    }
    
    if (nextButton) {
      nextButton.addEventListener('click', (e) => {
        e.preventDefault();
        updateActiveImage(currentIndex + 1);
      });
    }
    
      // Cambio automático de imágenes cada 4 segundos
    let autoplayInterval;
    
    const startAutoplay = () => {
      autoplayInterval = setInterval(() => {
        updateActiveImage(currentIndex + 1);
        }, 4000);
    };
    
    const stopAutoplay = () => {
      clearInterval(autoplayInterval);
    };
    
    // Iniciar autoplay
    startAutoplay();
    
      // Detener autoplay al interactuar
    productCard.addEventListener('mouseenter', stopAutoplay);
    productCard.addEventListener('mouseleave', startAutoplay);
      
      // Detener autoplay al hacer clic en controles
      [...controls, prevButton, nextButton].forEach(control => {
        if (control) {
          control.addEventListener('click', stopAutoplay);
          setTimeout(startAutoplay, 2000);
        }
      });
    }
    
    // Funcionalidad de favoritos
    if (favoriteButton) {
      const isFavorited = localStorage.getItem(`favorite-${id}`) === 'true';
      if (isFavorited) {
        favoriteButton.classList.add('product-card__favorite--active');
      }
      
      favoriteButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const isCurrentlyFavorited = favoriteButton.classList.contains('product-card__favorite--active');
        
        if (isCurrentlyFavorited) {
          favoriteButton.classList.remove('product-card__favorite--active');
          localStorage.removeItem(`favorite-${id}`);
          showNotification('Producto removido de favoritos', 'info');
        } else {
          favoriteButton.classList.add('product-card__favorite--active');
          localStorage.setItem(`favorite-${id}`, 'true');
          showNotification('Producto agregado a favoritos', 'success');
        }
      });
    }
    
    // Funcionalidad de vista rápida
    if (quickViewButton) {
      quickViewButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Crear modal de vista rápida
        createQuickViewModal(productCard);
      });
    }
    
    // Sin interacción en el chip de stock

    // Efecto de zoom en la imagen al hover
    const imageContainer = productCard.querySelector('.product-card__images');
    if (imageContainer) {
      imageContainer.addEventListener('mouseenter', () => {
        const activeImage = productCard.querySelector('.product-card__image--active img');
        if (activeImage) {
          activeImage.style.transform = 'scale(1.1)';
        }
      });
      
      imageContainer.addEventListener('mouseleave', () => {
        const activeImage = productCard.querySelector('.product-card__image--active img');
        if (activeImage) {
          activeImage.style.transform = 'scale(1)';
        }
      });
    }
  });
  
  // Función para crear modal de vista rápida
  function createQuickViewModal(productCard) {
    const productId = productCard.getAttribute('data-product-id');
    const productTitle = productCard.querySelector('.product-card__title').textContent;
    const productPrice = productCard.querySelector('.product-card__price').textContent;
    const productDescription = productCard.querySelector('.product-card__description').textContent;
    const productImages = Array.from(productCard.querySelectorAll('.product-card__image img')).map(img => img.src);
    
    // Crear overlay
    const overlay = document.createElement('div');
    overlay.className = 'quick-view-overlay';
    overlay.innerHTML = `
      <div class="quick-view-modal">
        <div class="quick-view-modal__header">
          <h3 class="quick-view-modal__title">${productTitle}</h3>
          <button class="quick-view-modal__close" aria-label="Cerrar vista rápida">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <div class="quick-view-modal__content">
          <div class="quick-view-modal__image">
            <img src="${productImages[0]}" alt="${productTitle}" class="quick-view-modal__img">
          </div>
          
          <div class="quick-view-modal__details">
            <div class="quick-view-modal__price">${productPrice}</div>
            <p class="quick-view-modal__description">${productDescription}</p>
            
            <div class="quick-view-modal__actions">
              <button class="btn btn--primary btn--full" onclick="addToCart('${productId}', '${productTitle}', ${parseFloat(productPrice.replace('$', ''))}, '${productImages[0]}'); closeQuickView();">
                Agregar al carrito
              </button>
              <button class="btn btn--secondary btn--full" onclick="closeQuickView();">
                Ver detalles completos
              </button>
            </div>
          </div>
        </div>
      </div>
    `;
    
    // Agregar estilos para el modal
    const style = document.createElement('style');
    style.textContent = `
      .quick-view-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: fadeIn 0.3s ease-out;
      }
      
      .quick-view-modal {
        background: white;
        border-radius: 1rem;
        max-width: 800px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        animation: slideInUp 0.3s ease-out;
      }
      
      .quick-view-modal__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #e5e7eb;
      }
      
      .quick-view-modal__title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
      }
      
      .quick-view-modal__close {
        background: none;
        border: none;
        padding: 0.5rem;
        border-radius: 0.5rem;
        cursor: pointer;
        color: #6b7280;
        transition: all 0.2s ease;
      }
      
      .quick-view-modal__close:hover {
        background: #f3f4f6;
        color: #374151;
      }
      
      .quick-view-modal__close svg {
        width: 1.5rem;
        height: 1.5rem;
      }
      
      .quick-view-modal__content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        padding: 1.5rem;
      }
      
      .quick-view-modal__image {
        aspect-ratio: 1;
        border-radius: 0.75rem;
        overflow: hidden;
      }
      
      .quick-view-modal__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      .quick-view-modal__price {
        font-size: 2rem;
        font-weight: 800;
        color: #059669;
        margin-bottom: 1rem;
      }
      
      .quick-view-modal__description {
        color: #6b7280;
        line-height: 1.6;
        margin-bottom: 2rem;
      }
      
      .quick-view-modal__actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      
      @media (max-width: 768px) {
        .quick-view-modal__content {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      
      @keyframes slideInUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    `;
    
    document.head.appendChild(style);
    document.body.appendChild(overlay);
    document.body.style.overflow = 'hidden';
    
    // Cerrar modal al hacer clic en el overlay
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeQuickView();
      }
    });
    
    // Cerrar modal con botón
    overlay.querySelector('.quick-view-modal__close').addEventListener('click', closeQuickView);
    
    // Cerrar modal con Escape
    const handleEscape = (e) => {
      if (e.key === 'Escape') {
        closeQuickView();
      }
    };
    document.addEventListener('keydown', handleEscape);
    
    // Función para cerrar el modal
    window.closeQuickView = () => {
      overlay.style.animation = 'fadeOut 0.3s ease-out forwards';
      setTimeout(() => {
        document.body.removeChild(overlay);
        document.head.removeChild(style);
        document.body.style.overflow = '';
        document.removeEventListener('keydown', handleEscape);
        delete window.closeQuickView;
      }, 300);
    };
  }
  
  // Función para mostrar notificaciones
  function showNotification(message, type = 'success') {
    const notification = document.createElement('div');
    notification.className = `notification notification--${type}`;
    notification.innerHTML = `
      <div class="notification__content">
        <span class="notification__icon">${type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️'}</span>
        <span class="notification__message">${message}</span>
        <button class="notification__close" onclick="this.parentElement.parentElement.remove()">×</button>
      </div>
    `;
    
    document.body.appendChild(notification);
    
    // Auto-remove after 3 seconds
    setTimeout(() => {
      if (notification.parentElement) {
        notification.remove();
      }
    }, 3000);
  }
</script>

<style>
  /* sin estilos de modal de stock */
</style>

<style>
  .product-card {
    background: #0f1218;
    border: 1px solid #1e2433;
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    box-shadow: 0 12px 30px rgba(0,0,0,.35);
    transition: transform .18s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .product-card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(0,0,0,.45); border-color: #2a3246; }

  .product-card__images { position: relative; aspect-ratio: 1 / 1; background: #0b0e14; }
  .product-card__image { position: absolute; inset: 0; opacity: 0; transform: scale(1.02); transition: opacity .35s ease, transform .35s ease; }
  .product-card__image--active { opacity: 1; transform: scale(1); }
  .product-card__image-content { width: 100%; height: 100%; object-fit: cover; display: block; }
  .product-card__gradient { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,.45)); pointer-events: none; }

  .product-card__controls { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; }
  .product-card__dot { width: 8px; height: 8px; border-radius: 999px; background: #2a3246; border: 1px solid #3a4763; opacity: .8; transition: opacity .2s ease, transform .2s ease, background .2s ease; }
  .product-card__dot--active, .product-card__dot:hover { background: #9eb6ff; opacity: 1; transform: scale(1.1); }
  .product-card__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; border-radius: 10px; backdrop-filter: blur(6px); border: 1px solid #283249; background: rgba(15,18,24,.6); color: #cdd7ee; display: grid; place-items: center; cursor: pointer; transition: transform .12s ease, filter .2s ease; }
  .product-card__nav:active { transform: translateY(-50%) scale(.98); }
  .product-card__nav--prev { left: 8px; }
  .product-card__nav--next { right: 8px; }
  .product-card__nav-icon { width: 18px; height: 18px; }

  .product-card__badges { position: absolute; top: 10px; left: 10px; display: flex; gap: 6px; }
  .product-card__badge { border-radius: 999px; padding: 4px 8px; font-size: 12px; font-weight: 800; border: 1px solid #24324a; background: rgba(17,23,33,.65); color: #eaf0ff; backdrop-filter: blur(6px); }
  .product-card__badge--discount { color: #fce7f3; border-color: #4b2440; background: rgba(41,17,32,.65); }
  .product-card__badge--new { color: #d1fae5; border-color: #1a3b2e; background: rgba(14,24,20,.65); }
  .product-card__badge--featured { color: #fff7cc; border-color: #473c14; background: rgba(31,27,16,.65); }

  .product-card__favorite, .product-card__quick-view { position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border-radius: 10px; border: 1px solid #283249; background: rgba(15,18,24,.6); color: #cdd7ee; display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(6px); }
  .product-card__quick-view { top: 50px; }
  .product-card__favorite--active { color: #ff9db0; border-color: #4a2430; background: rgba(32,16,22,.6); }
  .product-card__favorite-icon, .product-card__quick-view-icon { width: 18px; height: 18px; }

  .product-card__stock-indicator { position: absolute; bottom: 10px; right: 10px; }
  .product-card__stock { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; border-radius: 999px; padding: 4px 8px; border: 1px solid #233049; background: rgba(16,22,33,.65); color: #cfe2ff; }
  .product-card__stock--available { color: #bbf7d0; border-color: #1b3a2c; background: rgba(13,22,18,.65); }
  .product-card__stock--low { color: #fde68a; border-color: #453a1a; background: rgba(31,27,16,.65); }
  .product-card__stock--out { color: #fecaca; border-color: #4a2323; background: rgba(31,16,16,.65); }
  .product-card__stock-icon { width: 16px; height: 16px; }

  .product-card__content { padding: 12px; display: grid; gap: 8px; }
  .product-card__category-text { color: #9fb1d1; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .product-card__title { margin: 0; color: #e9eef9; font-size: 18px; }
  .product-card__rating { display: flex; align-items: center; gap: 6px; }
  .product-card__star { width: 16px; height: 16px; color: #334155; }
