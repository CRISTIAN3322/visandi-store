---
import ProductImage from '../atoms/ProductImage.astro';
import Button from '../atoms/Button.astro';

interface Props {
  id: string;
  name: string;
  price: number;
  images: string[];
  description: string;
}

const { id, name, price, images, description } = Astro.props;
---

<div class="product-card" data-product-id={id}>
  <div class="product-images">
    {images.map((image, index) => (
      <div class={`product-image ${index === 0 ? 'active' : ''}`} data-index={index}>
        <ProductImage src={image} alt={`${name} - Imagen ${index + 1}`} class="product-img" />
      </div>
    ))}
    
    <div class="image-gradient"></div>
    
    {images.length > 1 && (
      <>
        <div class="image-controls">
          {images.map((_, index) => (
            <button 
              class={`image-dot ${index === 0 ? 'active-dot' : ''}`}
              data-control={index}
              aria-label={`Ver imagen ${index + 1}`}
            ></button>
          ))}
        </div>
        
        <button class="nav-button nav-button-prev" aria-label="Imagen anterior">
          <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button class="nav-button nav-button-next" aria-label="Imagen siguiente">
          <svg xmlns="http://www.w3.org/2000/svg" class="nav-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}
    
    <div class="badge-new">
      <span class="badge-new-text">Nuevo</span>
    </div>
  </div>
  
  <div class="card-content">
    <h3 class="product-title">{name}</h3>
    <p class="product-description">{description}</p>
    <div class="card-footer">
      <span class="product-price">${price.toFixed(2)}</span>
      <Button 
        text="Agregar al carrito" 
        type="primary" 
        onClick={`addToCart('${id}', '${name}', ${price}, '${images[0]}')`}
        
      />
    </div>
  </div>
</div>

<style>
  /* Estilos mejorados para la tarjeta de producto */
  .product-card {
    width: 100%;
    max-width: 320px;
    height: 480px;
    background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
    border: 1px solid rgba(229, 231, 235, 0.5);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 
      0 4px 6px rgba(0, 0, 0, 0.05),
      0 10px 15px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    position: relative;
    backdrop-filter: blur(10px);
  }
  
  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: 20px;
  }
  
  .product-card:hover {
    box-shadow: 
      0 20px 25px rgba(0, 0, 0, 0.1),
      0 10px 10px rgba(0, 0, 0, 0.04),
      0 0 0 1px rgba(5, 150, 105, 0.1);
    transform: translateY(-12px) scale(1.02);
    border-color: rgba(5, 150, 105, 0.2);
  }
  
  .product-card:hover::before {
    opacity: 1;
  }
  
  /* Contenedor de imágenes mejorado */
  .product-images {
    position: relative;
    height: 240px;
    overflow: hidden;
    border-radius: 20px 20px 0 0;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  }
  
  /* Imágenes con efectos mejorados */
  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(1.1);
  }
  
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    filter: brightness(0.95) contrast(1.05);
  }
  
  .product-card:hover .product-img {
    transform: scale(1.08);
    filter: brightness(1) contrast(1.1) saturate(1.1);
  }
  
  .product-image.active {
    opacity: 1;
    z-index: 1;
    transform: scale(1);
  }
  
  /* Gradiente mejorado sobre la imagen */
  .image-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg, 
      rgba(0,0,0,0.1) 0%, 
      transparent 30%, 
      transparent 70%, 
      rgba(0,0,0,0.3) 100%
    );
    opacity: 0;
    transition: all 0.4s ease;
    z-index: 2;
  }
  
  .product-card:hover .image-gradient {
    opacity: 1;
    background: linear-gradient(
      135deg, 
      rgba(5, 150, 105, 0.2) 0%, 
      transparent 30%, 
      transparent 70%, 
      rgba(0,0,0,0.4) 100%
    );
  }
  
  /* Controles de navegación mejorados */
  .image-controls {
    position: absolute;
    bottom: 15px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
    z-index: 3;
  }
  
  .image-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
  }
  
  .image-dot:hover, .active-dot {
    background-color: white;
    border-color: white;
    transform: scale(1.4);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
  }
  
  /* Botones de navegación mejorados */
  .nav-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    box-shadow: 
      0 4px 8px rgba(5, 150, 105, 0.3),
      0 0 0 2px rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 3;
    backdrop-filter: blur(10px);
  }
  
  .nav-button-prev {
    left: 12px;
  }
  
  .nav-button-next {
    right: 12px;
  }
  
  .product-card:hover .nav-button {
    opacity: 1;
  }
  
  .nav-button:hover {
    background: linear-gradient(135deg, #047857 0%, #059669 100%);
    transform: translateY(-50%) scale(1.15);
    box-shadow: 
      0 6px 12px rgba(5, 150, 105, 0.4),
      0 0 0 3px rgba(255, 255, 255, 0.2);
  }
  
  .nav-icon {
    width: 18px;
    height: 18px;
    color: white;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
  }
  
  /* Etiqueta de nuevo mejorada */
  .badge-new {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 3;
  }
  
  .badge-new-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 15px;
    box-shadow: 
      0 4px 8px rgba(245, 158, 11, 0.3),
      0 0 0 2px rgba(255, 255, 255, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  /* Contenido de la tarjeta mejorado */
  .card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.9) 100%);
  }
  
  .product-title {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 10px;
    transition: all 0.3s ease;
    line-height: 1.3;
  }
  
  .product-card:hover .product-title {
    color: #059669;
    transform: translateY(-2px);
  }
  
  .product-description {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    line-height: 1.5;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(229, 231, 235, 0.3);
  }
  
  .product-price {
    font-size: 22px;
    font-weight: 800;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 2px 4px rgba(5, 150, 105, 0.1);
  }
  
  /* Estilos mejorados para el botón de agregar al carrito */
  :global(.add-to-cart-btn) {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
    padding: 10px 16px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    border-radius: 12px !important;
    color: white !important;
    box-shadow: 
      0 4px 8px rgba(5, 150, 105, 0.3),
      0 0 0 2px rgba(255, 255, 255, 0.1) !important;
    transform: translateY(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    border: none !important;
    cursor: pointer !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    backdrop-filter: blur(10px) !important;
  }
  
  :global(.add-to-cart-btn:hover) {
    background: linear-gradient(135deg, #047857 0%, #059669 100%) !important;
    transform: translateY(-3px) scale(1.05);
    box-shadow: 
      0 8px 16px rgba(5, 150, 105, 0.4),
      0 0 0 3px rgba(255, 255, 255, 0.2) !important;
  }
  
  :global(.add-to-cart-btn:active) {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 
      0 4px 8px rgba(5, 150, 105, 0.3),
      0 0 0 2px rgba(255, 255, 255, 0.1) !important;
  }
</style>

<script define:vars={{ id }}>
  document.addEventListener('DOMContentLoaded', () => {
    const productCard = document.querySelector(`.product-card[data-product-id="${id}"]`);
    if (!productCard) return;
    
    const images = productCard.querySelectorAll('.product-image');
    const controls = productCard.querySelectorAll('[data-control]');
    const prevButton = productCard.querySelector('.nav-button-prev');
    const nextButton = productCard.querySelector('.nav-button-next');
    
    if (images.length <= 1) return;
    
    let currentIndex = 0;
    
    // Función para actualizar la imagen activa
    const updateActiveImage = (index) => {
      // Asegurarse de que el índice esté dentro del rango
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      
      currentIndex = index;
      
      // Actualizar imágenes
      images.forEach(img => img.classList.remove('active'));
      images[currentIndex].classList.add('active');
      
      // Actualizar controles
      controls.forEach((ctrl, i) => {
        if (i === currentIndex) {
          ctrl.classList.add('active-dot');
        } else {
          ctrl.classList.remove('active-dot');
        }
      });
    };
    
    // Configurar eventos para los controles de puntos
    controls.forEach(control => {
      control.addEventListener('click', () => {
        const index = parseInt(control.getAttribute('data-control'));
        updateActiveImage(index);
      });
    });
    
    // Configurar eventos para los botones de navegación
    if (prevButton) {
      prevButton.addEventListener('click', (e) => {
        e.preventDefault();
        updateActiveImage(currentIndex - 1);
      });
    }
    
    if (nextButton) {
      nextButton.addEventListener('click', (e) => {
        e.preventDefault();
        updateActiveImage(currentIndex + 1);
      });
    }
    
    // Cambio automático de imágenes cada 5 segundos
    let autoplayInterval;
    
    const startAutoplay = () => {
      autoplayInterval = setInterval(() => {
        updateActiveImage(currentIndex + 1);
      }, 5000);
    };
    
    const stopAutoplay = () => {
      clearInterval(autoplayInterval);
    };
    
    // Iniciar autoplay
    startAutoplay();
    
    // Detener autoplay al pasar el ratón por encima
    productCard.addEventListener('mouseenter', stopAutoplay);
    productCard.addEventListener('mouseleave', startAutoplay);
  });
</script>