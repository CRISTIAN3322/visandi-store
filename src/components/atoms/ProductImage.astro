---
interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className = '' } = Astro.props;
---

<img 
  src={src} 
  alt={alt} 
  class={`rounded-lg object-cover ${className}`} 
  loading="lazy"
/>

<style>
  img {
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }
</style>