---
interface Props {
  text: string;
  type?: 'primary' | 'secondary';
  onClick?: string;
  fullWidth?: boolean;
  icon?: string;
}

const { text, type = 'primary', onClick, fullWidth = false, icon } = Astro.props;
---

<button
  class={`btn btn--${type} ${fullWidth ? 'btn--full' : ''}`}
  onclick={onClick}
>
  {icon && <span class="btn__icon">{icon}</span>}
  <span class="btn__text">{text}</span>
</button>
