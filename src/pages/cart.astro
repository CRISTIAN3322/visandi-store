---
import Layout from '../layouts/Layout.astro';
import CartSummary from '../components/organisms/CartSummary.astro';
import { DEFAULT_WHATSAPP_NUMBER } from '../config/whatsapp';

const defaultWhatsAppNumber = DEFAULT_WHATSAPP_NUMBER;
---

<Layout title="Carrito de Compras - Visandi Store">
  <main class="cart-page">
    <div class="cart-page__container">
      <div class="cart-page__header">
        <h1 class="cart-page__title">
          <span class="cart-page__icon">🛒</span>
          Carrito de Compras
        </h1>
        <p class="cart-page__subtitle">Revisa tu pedido y completa tus datos</p>
      </div>

      <div class="cart-page__content">
        <div class="cart-page__summary">
          <CartSummary />
        </div>
        
        <div class="cart-page__form">
          <div class="cart-page__form-card">
            <div class="cart-page__form-header">
              <h2 class="cart-page__form-title">
                <span class="cart-page__form-icon">👤</span>
                Datos del Cliente
              </h2>
              <p class="cart-page__form-description">Completa tus datos para procesar el pedido</p>
            </div>

            <form class="cart-page__form-form" id="customerForm">
              <div class="cart-page__form-grid">
                <div class="cart-page__form-group">
                  <label for="fullName" class="cart-page__form-label">
                    <span class="cart-page__form-label-icon">👤</span>
                    Nombre Completo *
                  </label>
                  <input 
                    type="text" 
                    id="fullName" 
                    name="fullName" 
                    class="cart-page__form-input" 
                    placeholder="Ej: Juan Pérez"
                    required
                    autocomplete="name"
                  >
                  <div class="cart-page__form-error" id="fullNameError"></div>
                </div>

                <div class="cart-page__form-group">
                  <label for="phone" class="cart-page__form-label">
                    <span class="cart-page__form-label-icon">📱</span>
                    Teléfono *
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="cart-page__form-input" 
                    placeholder="Ej: 3001234567"
                    maxlength="15"
                    inputmode="numeric"
                    required
                    autocomplete="tel"
                  >
                  <div class="cart-page__form-error" id="phoneError"></div>
                </div>
              </div>
              
            </form>
          </div>
        </div>
      </div>
      
      <div class="cart-page__actions" id="cartPageActions" style="display: none;">
        <div class="cart-page__actions-row">
          <button type="button" class="cart-page__btn cart-page__btn--secondary" id="clearCart">
            Vaciar carrito
          </button>
          <button type="button" class="cart-page__btn cart-page__btn--whatsapp" id="sendWhatsApp">
            <span class="cart-page__btn-icon">📱</span>
            <span class="cart-page__btn-text">Enviar Pedido por WhatsApp</span>
          </button>
        </div>
        
        <!-- <div class="cart-page__wa-config">
          <label for="whatsappNumber" class="cart-page__wa-label">Número de WhatsApp del distribuidor</label>
          <input 
            type="tel"
            id="whatsappNumber"
            class="cart-page__form-input cart-page__wa-input"
            placeholder="Ej: 573001234567"
          >
          <div class="cart-page__wa-help">Ingresa el número donde recibes pedidos por WhatsApp</div>
        </div> -->

        <div class="cart-page__payment-info">
          <div class="cart-page__payment-icon">💳</div>
          <div class="cart-page__payment-text">
            <strong>Métodos de pago:</strong><br>
            Efectivo, Transferencia, Nequi, Daviplata
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ defaultWhatsAppNumber }}>
  document.addEventListener('DOMContentLoaded', function() {
    const CONFIG_DEFAULT_WA = defaultWhatsAppNumber;
    const form = document.getElementById('customerForm');
    const sendWhatsAppBtn = document.getElementById('sendWhatsApp');
    const clearCartBtn = document.getElementById('clearCart');
    const whatsappNumberInput = document.getElementById('whatsappNumber');
    const cartPageActions = document.getElementById('cartPageActions');

    // Mostrar/ocultar acciones según el carrito
    function updateCartActions() {
      try {
        const cartStr = localStorage.getItem('shopping-cart');
        const cart = cartStr ? JSON.parse(cartStr) : [];
        
        if (cartPageActions) {
          if (Array.isArray(cart) && cart.length > 0) {
            cartPageActions.style.display = 'block';
          } else {
            cartPageActions.style.display = 'none';
          }
        }
      } catch (error) {
        console.error('Error al actualizar acciones:', error);
      }
    }

    // Cargar número de WhatsApp guardado
    const savedWa = localStorage.getItem('whatsapp-number');
    if (savedWa && whatsappNumberInput) {
      whatsappNumberInput.value = savedWa;
    }

    // Validación del formulario
    function validateForm() {
      const fullNameInput = document.getElementById('fullName');
      const phoneInput = document.getElementById('phone');
      let isValid = true;

      // Limpiar errores anteriores
      document.querySelectorAll('.cart-page__form-error').forEach(error => error.textContent = '');
      document.querySelectorAll('.cart-page__form-input').forEach(input => input.classList.remove('cart-page__form-input--error'));

      // Validar nombre
      if (!fullNameInput) {
        showError('fullName', 'Campo no encontrado');
        isValid = false;
      } else {
        const fullName = fullNameInput.value.trim();
        if (!fullName || fullName.length < 2) {
          showError('fullName', 'El nombre debe tener al menos 2 caracteres');
          isValid = false;
        }
      }

      // Validar teléfono
      if (!phoneInput) {
        showError('phone', 'Campo no encontrado');
        isValid = false;
      } else {
        const phone = phoneInput.value.trim();
        const digits = phone.replace(/\D/g, '');
        if (!digits || digits.length < 7) {
          showError('phone', 'Ingresa un teléfono válido (mínimo 7 dígitos)');
          isValid = false;
        }
      }

      return isValid;
    }

    function showError(fieldName, message) {
      const field = document.getElementById(fieldName);
      const errorElement = document.getElementById(fieldName + 'Error');
      
      if (field) field.classList.add('cart-page__form-input--error');
      if (errorElement) errorElement.textContent = message;
    }

    // Enviar por WhatsApp
    function sendToWhatsApp() {
      console.log('=== INICIANDO ENVÍO DE PEDIDO ===');
      
      // Validar formulario primero
      if (!validateForm()) {
        console.log('Validación del formulario falló');
        showNotification('Por favor, completa todos los campos requeridos', 'error');
        return;
      }

      try {
        // Obtener carrito
        const cartStr = localStorage.getItem('shopping-cart');
        console.log('Carrito desde localStorage:', cartStr);
        
        if (!cartStr) {
          showNotification('Tu carrito está vacío', 'error');
          return;
        }
        
        let cart;
        try {
          cart = JSON.parse(cartStr);
        } catch (e) {
          console.error('Error al parsear carrito:', e);
          showNotification('Error al leer el carrito', 'error');
          return;
        }
        
        if (!Array.isArray(cart) || cart.length === 0) {
          showNotification('Tu carrito está vacío', 'error');
          return;
        }
        
        console.log('Productos en el carrito:', cart);

        // Obtener número de WhatsApp del distribuidor
        let distributorNumber = CONFIG_DEFAULT_WA;
        
        // Intentar obtener del input de WhatsApp (en la sección de acciones)
        const waInput = document.getElementById('whatsappNumber');
        if (waInput && waInput.value && waInput.value.trim()) {
          const inputValue = waInput.value.trim().replace(/[^0-9]/g, '');
          if (inputValue.length >= 10) {
            distributorNumber = inputValue;
            localStorage.setItem('whatsapp-number', distributorNumber);
            console.log('Número de WhatsApp del input:', distributorNumber);
          }
        } else {
          // Intentar obtener del localStorage
          const saved = localStorage.getItem('whatsapp-number');
          if (saved && saved.replace(/[^0-9]/g, '').length >= 10) {
            distributorNumber = saved.replace(/[^0-9]/g, '');
            console.log('Número de WhatsApp guardado:', distributorNumber);
          } else {
            distributorNumber = CONFIG_DEFAULT_WA;
            console.log('Usando número de WhatsApp por defecto:', distributorNumber);
          }
        }

        // Obtener datos del cliente del formulario
        const fullNameInput = document.getElementById('fullName');
        const phoneInput = document.getElementById('phone');
        
        if (!fullNameInput || !phoneInput) {
          console.error('Campos del formulario no encontrados');
          showNotification('Error: No se encontraron los campos del formulario', 'error');
          return;
        }
        
        const fullName = fullNameInput.value.trim();
        const phone = phoneInput.value.trim();
        
        console.log('Datos del cliente:', { fullName, phone });
        
        if (!fullName || !phone) {
          showNotification('Por favor, completa todos los campos', 'error');
          return;
        }
        
        // Crear mensaje personalizado
        let message = `*🛒 NUEVO PEDIDO - VISANDI STORE*\n\n`;
        message += `*👤 DATOS DEL CLIENTE:*\n`;
        message += `• Nombre: ${fullName}\n`;
        message += `• Teléfono: ${phone}\n\n`;
        message += `*📦 PRODUCTOS A COMPRAR:*\n\n`;
        
        cart.forEach(function(item, index) {
          const itemPrice = Number(item.price) || 0;
          const itemQuantity = Number(item.quantity) || 0;
          const itemSubtotal = itemPrice * itemQuantity;
          
          message += `${index + 1}. *${String(item.name || 'Producto').replace(/\*/g, '')}*\n`;
          message += `   • Cantidad: ${itemQuantity}\n`;
          const formatPrice = window.formatPrice || ((p) => p.toLocaleString());
          message += `   • Precio unitario: $${formatPrice(itemPrice)}\n`;
          message += `   • Subtotal: $${formatPrice(itemSubtotal)}\n\n`;
        });
        
        // Calcular totales
        const subtotal = cart.reduce(function(sum, item) {
          const price = Number(item.price) || 0;
          const quantity = Number(item.quantity) || 0;
          return sum + (price * quantity);
        }, 0);
        
        const shipping = subtotal > 50000 ? 0 : 5000;
        const total = subtotal + shipping;
        
        message += `*💰 RESUMEN DEL PEDIDO:*\n`;
        const formatPrice = window.formatPrice || ((p) => p.toLocaleString());
        message += `• Subtotal: $${formatPrice(subtotal)}\n`;
        message += `• Envío: ${shipping === 0 ? 'GRATIS' : `$${formatPrice(shipping)}`}\n`;
        message += `• *TOTAL A PAGAR: $${formatPrice(total)}*\n\n`;
        message += `¡Gracias por tu pedido! 🎉\n`;
        message += `Te contactaremos pronto para confirmar los detalles.`;

        // Codificar mensaje y crear URL
        const encodedMessage = encodeURIComponent(message);
        const whatsappUrl = `https://wa.me/${distributorNumber}?text=${encodedMessage}`;
        
        console.log('URL de WhatsApp generada:', whatsappUrl);
        console.log('Mensaje completo:', message);
        
        // Abrir WhatsApp en nueva ventana
        const whatsappWindow = window.open(whatsappUrl, '_blank');
        
        if (whatsappWindow) {
          showNotification('¡Redirigiendo a WhatsApp...', 'success');
          
          // Vaciar el carrito después de enviar el pedido
          localStorage.removeItem('shopping-cart');
          window.dispatchEvent(new CustomEvent('cartUpdated'));
          updateCartActions();
          showNotification('Pedido enviado. El carrito ha sido vaciado.', 'success');
        } else {
          // Si el popup fue bloqueado, mostrar el enlace
          showNotification('Por favor, permite ventanas emergentes o haz clic aquí', 'error');
          console.error('Popup bloqueado. URL:', whatsappUrl);
        }
        
      } catch (error) {
        console.error('Error completo al enviar pedido:', error);
        showNotification('Error al enviar el pedido: ' + (error instanceof Error ? error.message : 'Error desconocido'), 'error');
      }
    }

    // Hacer sendToWhatsApp disponible globalmente
    window.sendToWhatsApp = sendToWhatsApp;

    // Event listeners
    if (sendWhatsAppBtn) {
      sendWhatsAppBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Botón sendWhatsApp clickeado');
        sendToWhatsApp();
        return false;
      });
      console.log('Event listener agregado a sendWhatsApp');
    } else {
      console.warn('Botón sendWhatsApp no encontrado');
    }
    
    // Prevenir submit del formulario al presionar Enter
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Formulario submit interceptado');
        sendToWhatsApp();
        return false;
      });
    }
    clearCartBtn?.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que quieres vaciar el carrito?')) {
      localStorage.removeItem('shopping-cart');
        window.dispatchEvent(new CustomEvent('cartUpdated'));
      showNotification('Carrito vaciado', 'success');
        updateCartActions();
      }
    });

    // Escuchar evento del botón de la tabla
    window.addEventListener('cartTableSendOrder', () => {
      // Hacer scroll al formulario y luego intentar enviar si está completo
      setTimeout(() => {
        if (validateForm()) {
          sendToWhatsApp();
        }
      }, 500);
    });

    // Actualizar acciones cuando cambia el carrito
    updateCartActions();
    window.addEventListener('cartUpdated', updateCartActions);
    window.addEventListener('storage', (e) => {
      if (e.key === 'shopping-cart') updateCartActions();
    });

    // Función para mostrar notificaciones
    function showNotification(message, type) {
      if (!type) type = 'success';
      const notification = document.createElement('div');
      notification.className = `cart-page__notification cart-page__notification--${type}`;
      notification.innerHTML = `
        <div class="cart-page__notification-content">
          <span class="cart-page__notification-icon">${type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️'}</span>
          <span class="cart-page__notification-message">${message}</span>
          <button class="cart-page__notification-close" onclick="this.parentElement.parentElement.remove()">×</button>
        </div>
      `;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        if (notification.parentElement) {
          notification.remove();
        }
      }, 4000);
    }
  });
</script>

<style>
  .cart-page {
    background: #0e0f12;
    min-height: 100vh;
    padding: 24px 0 48px;
  }

  .cart-page__container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .cart-page__header {
    margin: 8px 0 24px;
    text-align: left;
  }

  .cart-page__title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f5f7fb;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.2px;
    margin: 0 0 8px;
  }

  .cart-page__icon {
    font-size: 28px;
  }

  .cart-page__subtitle {
    color: #aab2c8;
    margin: 0;
    font-size: 14px;
  }

  .cart-page__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .cart-page__form-card {
    background: #151821;
    border: 1px solid #232837;
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    padding: 18px;
  }

  .cart-page__form-header {
    margin-bottom: 16px;
  }

  .cart-page__form-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f5f7fb;
    font-size: 20px;
    margin: 0;
    font-weight: 600;
  }

  .cart-page__form-icon {
    font-size: 20px;
  }

  .cart-page__form-description {
    color: #98a2b3;
    font-size: 13px;
    margin: 6px 0 0;
  }

  .cart-page__form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .cart-page__form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cart-page__form-label {
    color: #c6cede;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .cart-page__form-label-icon {
    font-size: 16px;
  }

  .cart-page__form-input {
    appearance: none;
    background: #0f1218;
    border: 1px solid #242a39;
    color: #e9eef9;
    border-radius: 10px;
    padding: 12px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    font-size: 14px;
  }

  .cart-page__form-input:focus {
    border-color: #3d7cff;
    box-shadow: 0 0 0 3px rgba(61,124,255,0.15);
    background: #111520;
  }

  .cart-page__form-input--error {
    border-color: #ff626c;
    box-shadow: 0 0 0 3px rgba(255,98,108,0.15);
  }

  .cart-page__form-error {
    color: #ff8087;
    font-size: 12px;
    min-height: 16px;
  }
  
  .cart-page__form-submit {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 2px solid #232837;
  }
  
  .cart-page__submit-btn {
    width: 100%;
    background: linear-gradient(135deg, #25d366 0%, #1ab855 100%);
    color: white;
    border: none;
    border-radius: 14px;
    padding: 20px 32px;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4), 0 0 0 0 rgba(37, 211, 102, 0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    overflow: hidden;
  }
  
  .cart-page__submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
  }
  
  .cart-page__submit-btn:hover::before {
    left: 100%;
  }
  
  .cart-page__submit-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.6), 0 0 20px rgba(37, 211, 102, 0.3);
    filter: brightness(1.1);
  }
  
  .cart-page__submit-btn:active {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
  }
  
  .cart-page__submit-btn-icon {
    font-size: 28px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    animation: pulse 2s ease-in-out infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }
  
  .cart-page__submit-btn-text {
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 1px;
  }
  
  .cart-page__submit-btn-arrow {
    font-size: 22px;
    transition: transform 0.3s ease;
  }
  
  .cart-page__submit-btn:hover .cart-page__submit-btn-arrow {
    transform: translateX(6px);
  }

  .cart-page__actions {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }

  .cart-page__actions-row {
    display: flex;
    gap: 12px;
    justify-content: space-between;
  }

  .cart-page__btn {
    appearance: none;
    border: 0;
    cursor: pointer;
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.08s ease, filter 0.2s ease;
    font-size: 14px;
  }

  .cart-page__btn:active {
    transform: translateY(1px);
  }

  .cart-page__btn-icon {
    font-size: 18px;
  }

  .cart-page__btn--secondary {
    background: #121622;
    color: #cdd7ee;
    border: 1px solid #2a3346;
  }

  .cart-page__btn--secondary:hover {
    filter: brightness(1.02);
  }

  .cart-page__btn--whatsapp {
    background: linear-gradient(180deg, #25d366, #1ab855);
    color: #07150f;
    box-shadow: 0 6px 14px rgba(37, 211, 102, 0.25);
  }

  .cart-page__btn--whatsapp:hover {
    filter: brightness(1.03);
  }

  .cart-page__wa-config {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .cart-page__wa-label {
    color: #9fb1d1;
    font-size: 12px;
  }

  .cart-page__wa-input {
    margin-top: 4px;
  }

  .cart-page__wa-help {
    color: #7f8aa3;
    font-size: 12px;
  }

  .cart-page__payment-info {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #0f1218;
    border: 1px solid #232837;
    border-radius: 10px;
    padding: 12px;
    margin-top: 12px;
  }

  .cart-page__payment-icon {
    font-size: 24px;
  }

  .cart-page__payment-text {
    color: #c6cede;
    font-size: 13px;
    line-height: 1.5;
  }

  .cart-page__notification {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 1000;
  }

  .cart-page__notification-content {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #121721;
    border: 1px solid #2a3346;
    padding: 10px 12px;
    border-radius: 12px;
    color: #e9eef9;
    box-shadow: 0 10px 24px rgba(0,0,0,0.35);
  }

  .cart-page__notification-icon {
    font-size: 18px;
  }

  .cart-page__notification-message {
    font-size: 14px;
  }

  .cart-page__notification-close {
    background: transparent;
    color: #9fb1d1;
    border: 0;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .cart-page__notification--success .cart-page__notification-content {
    border-color: #1d3e2e;
    background: #0d1612;
    color: #b0f1d1;
  }

  .cart-page__notification--error .cart-page__notification-content {
    border-color: #3a1e26;
    background: #1a0f13;
    color: #ffc4cb;
  }

  @media (max-width: 1024px) {
    .cart-page__content {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    
    .cart-page__summary {
      order: 2;
    }
    
    .cart-page__form {
      order: 1;
    }
  }

  @media (max-width: 768px) {
    .cart-page {
      padding: 16px 0 32px;
    }
    
    .cart-page__container {
      padding: 0 12px;
    }
    
    .cart-page__header {
      margin: 0 0 20px;
      text-align: center;
    }
    
    .cart-page__title {
      font-size: 24px;
      justify-content: center;
    }
    
    .cart-page__icon {
      font-size: 24px;
    }
    
    .cart-page__subtitle {
      font-size: 13px;
    }
    
    .cart-page__form-card {
      padding: 16px;
    }
    
    .cart-page__form-title {
      font-size: 18px;
    }
    
