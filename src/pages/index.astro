---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/organisms/ProductGrid.astro';
import ShoppingCart from '../components/organisms/ShoppingCart.astro';
import products from '../data/products.json';
import { DEFAULT_WHATSAPP_NUMBER } from '../config/whatsapp';

// Número de WhatsApp para enviar pedidos (configurable)
const whatsappNumber = DEFAULT_WHATSAPP_NUMBER;
---

<Layout title="Visandi Store - Toma de Pedidos">
  <section class="hero">
    <!-- Elementos decorativos de fondo -->
    <div class="hero__decoration">
      <div class="hero__decoration-circle hero__decoration-circle--1"></div>
      <div class="hero__decoration-circle hero__decoration-circle--2"></div>
      <div class="hero__decoration-circle hero__decoration-circle--3"></div>
    </div>
    
    <div class="hero__container container">
      <div class="hero__content">
        <h1 class="hero__title">
          Bienvenido a <span class="hero__title-highlight">Visandi Store</span>
        </h1>
        <p class="hero__description">
          Explora nuestra selección de productos únicos y realiza tu pedido fácilmente por WhatsApp
        </p>
        <div class="hero__buttons">
          <a href="#productos" class="hero__btn hero__btn--primary btn btn--lg">
            Ver Productos
          </a>
          <a href="#contacto" class="hero__btn hero__btn--secondary btn btn--lg">
            Contactar
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <section id="productos" class="products-section">
    <div class="products__container container">
      <div class="products__header">
        <h2 class="products__title">
          Nuestros <span class="products__title-highlight">Productos</span>
        </h2>
        <p class="products__description">
          Descubre nuestra colección cuidadosamente seleccionada de productos únicos y de calidad
        </p>
      </div>
      <ProductGrid products={products} />
    </div>
  </section>
  <ShoppingCart phoneNumber={whatsappNumber} />
  
  <!-- FAB WhatsApp en inicio -->
  <div class="fab-container">
    <button class="fab fab--whatsapp" id="homeFabWhatsApp" aria-label="Chatear por WhatsApp">
      <span class="fab__icon">💬</span>
    </button>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fab = document.getElementById('homeFabWhatsApp');
    fab?.addEventListener('click', () => {
      const saved = (localStorage.getItem('whatsapp-number') || '').replace(/[^0-9]/g, '');
      const fallback = '573123293314';
      const number = saved && saved.length >= 10 ? saved : fallback;
      const message = encodeURIComponent('Hola, me gustaría recibir asesoría 🌟');
      window.open(`https://wa.me/${number}?text=${message}`, '_blank');
    });
  });
</script>

