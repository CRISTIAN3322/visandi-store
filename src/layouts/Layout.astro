---
import { DEFAULT_WHATSAPP_NUMBER } from '../config/whatsapp';
import CartBadge from '../components/atoms/CartBadge.astro';
// Importar estilos CSS
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/pages.css';
import '../styles/accessibility.css';
import '../styles/performance.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Tienda online con sistema de pedidos por WhatsApp' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      /* FABs globales para usar también en Inicio */
      .fab-container { position: fixed; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 10px; z-index: 1010; }
      .fab { width: 56px; height: 56px; border-radius: 50%; border: 0; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 10px 26px rgba(0,0,0,.35); transition: transform .12s ease, filter .2s ease, box-shadow .2s ease; }
      .fab:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(0,0,0,.45); }
      .fab:active { transform: translateY(0); }
      .fab__icon { font-size: 22px; }
      .fab--whatsapp { background: linear-gradient(180deg, #25d366, #1ab855); color: #07150f; animation: fabPulse 2.8s ease-in-out infinite; }
      .fab--cart { position: relative; background: linear-gradient(180deg, #ffffff, #cfd8ff); color: #0b0d12; }
      .fab__badge { position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: #ef4444; color: #fff; font-weight: 800; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; border: 2px solid #0e0f12; }
      @keyframes fabPulse {
        0%, 100% { box-shadow: 0 10px 26px rgba(0,0,0,.35), 0 0 0 0 rgba(37, 211, 102, 0.0); }
        50% { box-shadow: 0 12px 30px rgba(0,0,0,.45), 0 0 0 10px rgba(37, 211, 102, 0.12); }
      }
      @media (max-width: 480px) {
        .fab { width: 54px; height: 54px; }
      }
      .header__cart-badge { 
        margin-left: 6px; 
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); 
        color: #fff; 
        border-radius: 999px; 
        padding: 2px 8px; 
        font-size: 11px; 
        font-weight: 800; 
        line-height: 1.2; 
        vertical-align: middle;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
        border: 2px solid white;
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header__container container">
        <a href="/login" class="header__logo">
          <img src="/images/logo.png" alt="Visandi Store" class="header__logo-image" />
        </a>
        
        <!-- Botón hamburguesa para móviles -->
        <button class="header__menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">
          <span class="header__menu-toggle-line"></span>
          <span class="header__menu-toggle-line"></span>
          <span class="header__menu-toggle-line"></span>
        </button>
        
        <!-- Overlay para móviles -->
        <div class="header__overlay" id="menuOverlay"></div>
        
        <nav class="header__navigation" id="headerNavigation">
          <ul class="header__nav-list">
            <li class="header__nav-item">
              <a href="/" class="header__nav-link" data-menu-link>
                Inicio
                <span class="header__nav-underline"></span>
              </a>
            </li>
            <li class="header__nav-item">
              <a href="/#productos" class="header__nav-link" data-menu-link>
                Productos
                <span class="header__nav-underline"></span>
              </a>
            </li>
            <li class="header__nav-item">
              <a href="/cart" class="header__nav-link header__nav-link--cart" id="headerCartLink" data-menu-link>
                <span class="header__nav-icon">🛒</span>
                <span class="header__nav-text">Carrito</span>
                <CartBadge />
                <span class="header__nav-underline"></span>
              </a>
            </li>
            <li class="header__nav-item">
              <a href="/#contacto" class="header__nav-link" data-menu-link>
                Contacto
                <span class="header__nav-underline"></span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    
    <script>
      // Función global para formatear precios con separador de miles (formato colombiano)
      window.formatPrice = function(price) {
        if (typeof price !== 'number') {
          price = parseFloat(price) || 0;
        }
        return price.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      };
      
      // Menú móvil hamburguesa
      document.addEventListener('DOMContentLoaded', function() {
        const menuToggle = document.getElementById('menuToggle');
        const menuOverlay = document.getElementById('menuOverlay');
        const headerNavigation = document.getElementById('headerNavigation');
        const menuLinks = document.querySelectorAll('[data-menu-link]');
        const body = document.body;
        
        function openMenu() {
          menuToggle?.setAttribute('aria-expanded', 'true');
          menuToggle?.classList.add('header__menu-toggle--active');
          menuOverlay?.classList.add('header__overlay--active');
          headerNavigation?.classList.add('header__navigation--active');
          body.style.overflow = 'hidden';
        }
        
        function closeMenu() {
          menuToggle?.setAttribute('aria-expanded', 'false');
          menuToggle?.classList.remove('header__menu-toggle--active');
          menuOverlay?.classList.remove('header__overlay--active');
          headerNavigation?.classList.remove('header__navigation--active');
          body.style.overflow = '';
        }
        
        function toggleMenu() {
          const isOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        }
        
        menuToggle?.addEventListener('click', toggleMenu);
        menuOverlay?.addEventListener('click', closeMenu);
        
        // Cerrar menú al hacer clic en un enlace
        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            closeMenu();
          });
        });
        
        // Cerrar menú con Escape
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
            closeMenu();
          }
        });
        
        // Cerrar menú al redimensionar a desktop
        window.addEventListener('resize', function() {
          if (window.innerWidth >= 768 && menuToggle?.getAttribute('aria-expanded') === 'true') {
            closeMenu();
          }
        });
      });
    </script>
    
    <main>
      <slot />
    </main>
    
    <footer id="contacto" class="footer">
      <!-- Patrón de fondo decorativo -->
      <div class="footer__decoration">
        <div class="footer__decoration-circle footer__decoration-circle--1"></div>
        <div class="footer__decoration-circle footer__decoration-circle--2"></div>
        <div class="footer__decoration-circle footer__decoration-circle--3"></div>
      </div>
      
      <div class="footer__container container">
        <div class="footer__grid">
          <div class="footer__section">
            <h3 class="footer__title">
              <span class="footer__icon">🛒</span>
              <span class="footer__brand">Visandi Store</span>
            </h3>
            <p class="footer__description">Tu tienda online con envío de pedidos por WhatsApp. Productos de calidad con entrega rápida y atención personalizada.</p>
            <div class="footer__social-links">
              <a href="#" class="footer__social-link footer__social-link--facebook">
                <span class="sr-only">Facebook</span>
                <svg class="footer__social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"></path>
                </svg>
              </a>
              <a href="#" class="footer__social-link footer__social-link--instagram">
                <span class="sr-only">Instagram</span>
                <svg class="footer__social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"></path>
                </svg>
              </a>
              <a href="#" class="footer__social-link footer__social-link--whatsapp">
                <span class="sr-only">WhatsApp</span>
                <svg class="footer__social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M20.448 3.538a11.996 11.996 0 00-8.53-3.526C5.361.012 0 5.373 0 11.93c0 2.126.547 4.178 1.595 6.004L0 24l6.281-1.646a11.946 11.946 0 005.723 1.456h.006c6.554 0 11.917-5.363 11.917-11.92 0-3.181-1.242-6.18-3.479-8.352zM11.93 21.782h-.004a9.932 9.932 0 01-5.055-1.385l-.363-.215-3.759.986 1.004-3.665-.236-.375a9.923 9.923 0 01-1.524-5.26c0-5.445 4.435-9.88 9.886-9.88a9.87 9.87 0 017.006 2.906 9.872 9.872 0 012.867 7.01c-.004 5.447-4.436 9.878-9.822 9.878z"></path>
                </svg>
              </a>
            </div>
          </div>
          <div class="footer__section">
            <h3 class="footer__subtitle">Enlaces Rápidos</h3>
            <ul class="footer__links">
              <li class="footer__link-item">
                <a href="/" class="footer__link">
                  <span class="footer__link-indicator"></span>
                  <span>Inicio</span>
                </a>
              </li>
              <li class="footer__link-item">
                <a href="/#productos" class="footer__link">
                  <span class="footer__link-indicator"></span>
                  <span>Productos</span>
                </a>
              </li>
              <li class="footer__link-item">
                <a href="/#contacto" class="footer__link">
                  <span class="footer__link-indicator"></span>
                  <span>Contacto</span>
                </a>
              </li>
            </ul>
          </div>
          <div class="footer__section">
            <h3 class="footer__subtitle">Contáctanos</h3>
            <p class="footer__contact-text">¿Tienes preguntas? Escríbenos por WhatsApp y te responderemos al instante.</p>
            <a href={`https://wa.me/${DEFAULT_WHATSAPP_NUMBER}`} class="footer__whatsapp-btn btn btn--primary">
              <svg class="footer__whatsapp-icon" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.448 3.538a11.996 11.996 0 00-8.53-3.526C5.361.012 0 5.373 0 11.93c0 2.126.547 4.178 1.595 6.004L0 24l6.281-1.646a11.946 11.946 0 005.723 1.456h.006c6.554 0 11.917-5.363 11.917-11.92 0-3.181-1.242-6.18-3.479-8.352zM11.93 21.782h-.004a9.932 9.932 0 01-5.055-1.385l-.363-.215-3.759.986 1.004-3.665-.236-.375a9.923 9.923 0 01-1.524-5.26c0-5.445 4.435-9.88 9.886-9.88a9.87 9.87 0 017.006 2.906 9.872 9.872 0 012.867 7.01c-.004 5.447-4.436 9.878-9.822 9.878z"></path>
              </svg>
              Contactar por WhatsApp
            </a>
          </div>
        </div>
        <div class="footer__bottom">
          <p class="footer__copyright">&copy; {new Date().getFullYear()} Visandi Store. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
